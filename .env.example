# Copy to .env and fill in what you need. Everything is optional: with nothing set, the store runs
# with an M-Pesa simulator and a "test order" option — no money moves.

# ---------- M-Pesa (Safaricom Daraja — STK Push / Lipa na M-Pesa Online)
# Create an app at https://developer.safaricom.co.ke → My Apps, enable "M-Pesa Sandbox", copy its keys.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# sandbox (default) or production. Production also needs your own shortcode + passkey from Safaricom.
MPESA_ENV=sandbox
# Sandbox defaults to shortcode 174379 and its public passkey; leave blank for sandbox.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill, default) or CustomerBuyGoodsOnline (Till). For a till, set MPESA_PARTY_B to the till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Public https base URL Safaricom can reach for payment callbacks (e.g. https://shop.example.com, or an
# ngrok URL while developing). Without it the store still works by polling Safaricom for the result.
MPESA_CALLBACK_BASE=
# Store prices are in USD; M-Pesa charges KES at this rate (rounded up to the shilling). Set your own.
KES_PER_USD=129

# ---------- Card payments (Stripe Checkout)
# Use test keys (sk_test_…) first: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8787/api/stripe/webhook` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# ---------- Server
# Public site URL (used for Stripe return links and as the M-Pesa callback base if MPESA_CALLBACK_BASE is empty).
PUBLIC_URL=
PORT=8787

# ---------- AI images (npm run images) — set ONE of these and pass --provider accordingly
# openai: https://platform.openai.com/api-keys  (model gpt-image-1)
OPENAI_API_KEY=
# gemini: https://aistudio.google.com/apikey   (model gemini-2.5-flash-image)
GEMINI_API_KEY=
# replicate: https://replicate.com/account/api-tokens  (model black-forest-labs/flux-1.1-pro)
REPLICATE_API_TOKEN=
# Default provider when --provider isn't given: openai | gemini | replicate
IMAGE_PROVIDER=

# ---------- Store admin
# Comma-separated emails that get the admin area (/admin) after signing in with that email.
# Create the account at /sign-in first (or after) — the email just has to match.
ADMIN_EMAILS=
