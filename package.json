{
  "name": "heartfelt-gifts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
